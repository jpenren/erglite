{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ErgLite",
  "version": "0.4.0",
  "identifier": "dev.erglite.app",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "ErgLite", "width": 1360, "height": 860, "minWidth": 1100, "minHeight": 700, "resizable": true }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Sports",
    "shortDescription": "Structured indoor cycling without a subscription",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "infoPlist": "Info.plist" }
  }
}
