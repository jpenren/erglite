---
import { Image } from 'astro:assets';
import AppWindow from './AppWindow.astro';
import Icon from './Icon.astro';
import routeSession from '../assets/screens/02-session-route.png';
import routeEditor from '../assets/screens/04-route-editor.png';

const grades = [
  { label: 'Descent', value: '−7%', color: 'var(--grade-descent)' },
  { label: 'Flat', value: '0%', color: 'var(--grade-flat)' },
  { label: 'Climb', value: '+4%', color: 'var(--grade-climb)' },
  { label: 'Wall', value: '+7%', color: 'var(--grade-climb-hard)' },
] as const;
---

<section class="section section--surface route" id="routes">
  <div class="container route__grid">
    <div class="route__visual reveal">
      <div class="route__aura" aria-hidden="true"></div>

      <AppWindow
        src={routeSession}
        alt="ErgLite route-mode session with current gradient, power, speed, cadence and the elevation profile"
        title="Session · 10 km circuit"
        tag="Route"
        sizes="(max-width: 980px) 94vw, 680px"
      />

      <figure class="route__inset">
        <figcaption>
          <Icon name="route" size={15} />
          Route editor · draw or import GPX
        </figcaption>
        <Image
          src={routeEditor}
          alt="ErgLite route editor with a section-by-section elevation profile, drawing tools and GPX import"
          widths={[360, 540, 760]}
          sizes="(max-width: 980px) 46vw, 330px"
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <div class="route__copy reveal" data-delay="1">
      <span class="eyebrow">Route mode</span>
      <h2>Climb roads that don't exist.</h2>
      <p class="lede">
        Draw a route profile or import a GPX. The trainer changes resistance with every gradient,
        just like on the road. No videos, no virtual worlds: just you, the gradient and the watts.
      </p>

      <ul class="checklist">
        <li>
          <span class="checklist__icon"><Icon name="check" size={14} /></span>
          <span>Section-by-section elevation profile, with the gradient always labelled.</span>
        </li>
        <li>
          <span class="checklist__icon"><Icon name="check" size={14} /></span>
          <span>Gradient simulation and difficulty you can adjust on the fly.</span>
        </li>
        <li>
          <span class="checklist__icon"><Icon name="check" size={14} /></span>
          <span>Draw by hand, move nodes or import a GPX with smoothing.</span>
        </li>
        <li>
          <span class="checklist__icon"><Icon name="check" size={14} /></span>
          <span>Guidance power and estimated time based on your profile and the gradient.</span>
        </li>
      </ul>

      <div class="route__legend" aria-label="Colours by gradient">
        <span class="route__legend-label">Gradient at a glance</span>
        <ul>
          {
            grades.map((grade) => (
              <li>
                <i style={`background:${grade.color}`} aria-hidden="true" />
                <span>{grade.label}</span>
                <b class="number">{grade.value}</b>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .route {
    overflow: hidden;
  }

  .route::before {
    content: '';
    position: absolute;
    top: -20%;
    left: -16%;
    width: 760px;
    height: 760px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(232, 88, 159, 0.07), transparent 66%);
    pointer-events: none;
  }

  .route__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(48px, 7vw, 100px);
  }

  .route__copy h2 {
    margin-top: 16px;
    font-size: clamp(38px, 5vw, 60px);
  }

  .route__copy .lede {
    margin-top: 22px;
  }

  .checklist {
    display: grid;
    gap: 14px;
    margin-top: 30px;
  }

  .checklist li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.55;
  }

  .checklist__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    border: 1px solid rgba(242, 201, 76, 0.28);
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .route__legend {
    margin-top: 34px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
  }

  .route__legend-label {
    display: block;
    margin-bottom: 13px;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .route__legend ul {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .route__legend li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 11px;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    background: rgba(15, 20, 25, 0.55);
    color: var(--text-secondary);
    font-size: 12px;
  }

  .route__legend i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }

  .route__legend b {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
  }

  .route__visual {
    position: relative;
    padding-bottom: 158px;
  }

  .route__aura {
    position: absolute;
    inset: 4% -6% 6%;
    z-index: -1;
    background:
      radial-gradient(52% 50% at 42% 44%, rgba(232, 88, 159, 0.13), transparent 72%),
      radial-gradient(44% 44% at 70% 70%, rgba(76, 154, 255, 0.09), transparent 72%);
    filter: blur(50px);
  }

  .route__inset {
    position: absolute;
    right: -14px;
    bottom: 0;
    width: 44%;
    overflow: hidden;
    border: 1px solid rgba(58, 70, 84, 0.9);
    border-radius: 12px;
    background: var(--surface-alt);
    box-shadow: 0 28px 60px -24px rgba(0, 0, 0, 0.92);
  }

  .route__inset figcaption {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--border-subtle);
    background: #111821;
    color: var(--text-muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .route__inset figcaption svg {
    color: var(--accent);
    flex: none;
  }

  .route__inset :global(img) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 980px) {
    .route__grid {
      grid-template-columns: 1fr;
    }

    .route__visual {
      order: 2;
      max-width: 760px;
      padding-bottom: 0;
    }

    .route__copy {
      order: 1;
    }

    .route__inset {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .route__visual {
      padding-bottom: 0;
    }

    .route__inset {
      display: none;
    }
  }
</style>
