---
import Icon from './Icon.astro';
import appIcon from '../assets/app-icon.png';

const year = new Date().getFullYear();
const repo = 'https://github.com/jpenren/erglite';
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="brand" href={import.meta.env.BASE_URL} aria-label="ErgLite, home">
          <img class="brand-mark" src={appIcon.src} alt="" width="36" height="36" />
          <span class="brand-name">Erg<span>Lite</span></span>
        </a>
        <p>Structured indoor training. No accounts, no cloud and no fees.</p>
        <a class="footer__github" href={repo} target="_blank" rel="noopener noreferrer">
          <Icon name="github" size={18} />
          <span>jpenren/erglite</span>
        </a>
      </div>

      <nav class="footer__col" aria-label="Product">
        <h3>Product</h3>
        <a href="#features">Features</a>
        <a href="#routes">Route mode</a>
        <a href="#how-it-works">How it works</a>
        <a href="#install">Install</a>
        <a href="#faq">FAQ</a>
      </nav>

      <nav class="footer__col" aria-label="Project">
        <h3>Project</h3>
        <a href={repo} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={`${repo}/releases/latest`} target="_blank" rel="noopener noreferrer">Releases</a>
        <a href={`${repo}/blob/main/docs/README.md`} target="_blank" rel="noopener noreferrer">Documentation</a>
        <a href={`${repo}/blob/main/docs/compatibility.md`} target="_blank" rel="noopener noreferrer">Compatibility</a>
        <a href={`${repo}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener noreferrer">Contributing</a>
      </nav>

      <nav class="footer__col" aria-label="Legal">
        <h3>Legal</h3>
        <a href={`${repo}/blob/main/LICENSE-MIT`} target="_blank" rel="noopener noreferrer">MIT License</a>
        <a href={`${repo}/blob/main/LICENSE-APACHE`} target="_blank" rel="noopener noreferrer">Apache-2.0 License</a>
        <a href={`${repo}/blob/main/SECURITY.md`} target="_blank" rel="noopener noreferrer">Security</a>
        <a href={`${repo}/blob/main/CODE_OF_CONDUCT.md`} target="_blank" rel="noopener noreferrer">Code of Conduct</a>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>© {year} ErgLite · Open source under MIT or Apache-2.0.</p>
      <p class="footer__disclaimer">
        Independent project. Zycle, ZPro and all other trademarks belong to their respective owners.
      </p>
      <p class="footer__made">Made for people who ride.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 64px 34px;
    border-top: 1px solid var(--border-subtle);
    background: #090e13;
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 0.8fr));
    gap: clamp(32px, 5vw, 72px);
  }

  .footer__brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .brand-mark {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    box-shadow: 0 0 0 1px rgba(242, 201, 76, 0.22);
  }

  .brand-name span {
    color: var(--accent);
  }

  .footer__brand p {
    max-width: 300px;
    margin-top: 16px;
    color: var(--text-muted);
    font-size: 14.5px;
    line-height: 1.6;
  }

  .footer__github {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    color: var(--text-secondary);
    font-size: 14px;
    transition: color 160ms ease;
  }

  .footer__github:hover {
    color: var(--accent);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .footer__col h3 {
    margin-bottom: 5px;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .footer__col a {
    width: fit-content;
    color: var(--text-secondary);
    font-size: 14px;
    transition: color 160ms ease;
  }

  .footer__col a:hover {
    color: var(--accent);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 28px;
    margin-top: 54px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 12px;
  }

  .footer__disclaimer {
    flex: 1;
    min-width: 260px;
    text-align: center;
  }

  .footer__made {
    color: var(--text-secondary);
  }

  @media (max-width: 860px) {
    .footer__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .footer__bottom {
      justify-content: flex-start;
    }

    .footer__disclaimer {
      text-align: left;
    }
  }
</style>
