---
import Icon from './Icon.astro';

const releasePage = 'https://github.com/jpenren/erglite/releases/latest';
---

<section class="section install" id="install">
  <div class="install__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="install__head reveal">
      <span class="eyebrow">Install</span>
      <h2>Install. Connect. Pedal.</h2>
      <p class="lede">
        Download the installer for your system. No account, no seven-day trial and no card.
      </p>
      <p class="install__version">
        Latest version:
        <span class="install__version-tag" data-release-version>0.5.0</span>
        <span class="install__version-sep" aria-hidden="true">·</span>
        <a class="text-link" href={releasePage} target="_blank" rel="noopener noreferrer">
          View all releases
          <Icon name="arrow-up-right" size={14} />
        </a>
      </p>
    </div>

    <div class="install__tabs-wrap reveal" data-delay="1">
      <div class="platform-tabs" role="tablist" aria-label="Choose your operating system">
        <button
          class="platform-tab"
          type="button"
          role="tab"
          id="tab-windows"
          aria-controls="panel-windows"
          aria-selected="true"
          tabindex="0"
          data-platform="windows"
        >
          <Icon name="windows" size={18} />
          Windows
        </button>
        <button
          class="platform-tab"
          type="button"
          role="tab"
          id="tab-macos"
          aria-controls="panel-macos"
          aria-selected="false"
          tabindex="-1"
          data-platform="macos"
        >
          <Icon name="apple" size={18} />
          macOS
        </button>
        <button
          class="platform-tab"
          type="button"
          role="tab"
          id="tab-linux"
          aria-controls="panel-linux"
          aria-selected="false"
          tabindex="-1"
          data-platform="linux"
        >
          <Icon name="terminal" size={18} />
          Linux
        </button>
      </div>
    </div>

    <div class="install__shell reveal" data-delay="2">
      <div
        class="install-panel"
        id="panel-windows"
        role="tabpanel"
        aria-labelledby="tab-windows"
        tabindex="0"
        data-panel="windows"
      >
        <div class="install-panel__main">
          <span class="install-panel__kicker"><Icon name="windows" size={15} /> Windows 10 & 11</span>
          <h3>The usual install, no surprises.</h3>
          <p>
            Download the installer, run it and open ErgLite. The wizard does the rest: no account,
            no sign-in and no initial setup.
          </p>

          <div class="download-row">
            <a
              class="button button--primary"
              href={releasePage}
              data-download="windows-msi"
            >
              <Icon name="download" size={18} />
              Download for Windows
              <span class="button__note">.msi</span>
            </a>
            <a
              class="button button--ghost"
              href={releasePage}
              data-download="windows-exe"
            >
              Install without admin
              <span class="button__note">.exe</span>
            </a>
          </div>

          <p class="install-panel__note">
            <Icon name="check-circle" size={15} />
            Windows 10 and 11. Windows 10 may need WebView2; Windows 11 includes it.
          </p>
        </div>

        <ol class="install-steps">
          <li>
            <span class="install-steps__num number">01</span>
            <div>
              <strong>Download the installer</strong>
              <p>Use the .msi for the whole machine or the .exe if you don't have administrator rights.</p>
            </div>
          </li>
          <li>
            <span class="install-steps__num number">02</span>
            <div>
              <strong>Run it and open ErgLite</strong>
              <p>Follow the wizard and open the app from the Start menu.</p>
            </div>
          </li>
          <li>
            <span class="install-steps__num number">03</span>
            <div>
              <strong>Connect your trainer</strong>
              <p>Power it on and find it in Devices. You'll be ready to pedal in seconds.</p>
            </div>
          </li>
        </ol>
      </div>

      <div
        class="install-panel"
        id="panel-macos"
        role="tabpanel"
        aria-labelledby="tab-macos"
        tabindex="0"
        data-panel="macos"
        hidden
      >
        <div class="install-panel__main">
          <span class="install-panel__kicker"><Icon name="apple" size={15} /> macOS · Intel and Apple Silicon</span>
          <h3>One DMG for every Mac.</h3>
          <p>
            The universal installer works the same on an Intel Mac and on Apple Silicon. Open it,
            drag the app to Applications and you're done.
          </p>

          <div class="download-row">
            <a
              class="button button--primary"
              href={releasePage}
              data-download="macos-dmg"
            >
              <Icon name="download" size={18} />
              Download for macOS
              <span class="button__note">.dmg</span>
            </a>
            <a
              class="button button--ghost"
              href={releasePage}
              target="_blank"
              rel="noopener noreferrer"
            >
              Other architectures
              <Icon name="arrow-up-right" size={16} />
            </a>
          </div>

          <p class="install-panel__note">
            <Icon name="check-circle" size={15} />
            Universal for Intel and Apple Silicon. No account or subscription.
          </p>

          <details class="install-details">
            <summary>macOS won't open the app the first time?</summary>
            <p>
              Right-click ErgLite and choose <strong>Open</strong>. If it's still blocked, remove
              the quarantine flag from Terminal:
            </p>
            <code>xattr -d com.apple.quarantine /Applications/ErgLite.app</code>
          </details>
        </div>

        <ol class="install-steps">
          <li>
            <span class="install-steps__num number">01</span>
            <div>
              <strong>Download the universal DMG</strong>
              <p>One download for Intel and Apple Silicon.</p>
            </div>
          </li>
          <li>
            <span class="install-steps__num number">02</span>
            <div>
              <strong>Drag ErgLite to Applications</strong>
              <p>Open the DMG and move the app to your Applications folder.</p>
            </div>
          </li>
          <li>
            <span class="install-steps__num number">03</span>
            <div>
              <strong>Open ErgLite and connect</strong>
              <p>Power on the trainer and find it in Devices. You're ready to start.</p>
            </div>
          </li>
        </ol>
      </div>

      <div
        class="install-panel"
        id="panel-linux"
        role="tabpanel"
        aria-labelledby="tab-linux"
        tabindex="0"
        data-panel="linux"
        hidden
      >
        <div class="install-panel__main">
          <span class="install-panel__kicker"><Icon name="terminal" size={15} /> Linux · AppImage, .deb and .rpm</span>
          <h3>Portable or integrated. Your choice.</h3>
          <p>
            The AppImage is a single file that runs without installing anything. If you'd rather
            integrate the app into your system, use the .deb or .rpm package for your distribution.
          </p>

          <div class="download-row download-row--linux">
            <a
              class="button button--primary"
              href={releasePage}
              data-download="linux-appimage"
            >
              <Icon name="download" size={18} />
              Download AppImage
              <span class="button__note">.AppImage</span>
            </a>
            <a
              class="button button--ghost"
              href={releasePage}
              data-download="linux-deb"
            >
              Package
              <span class="button__note">.deb</span>
            </a>
            <a
              class="button button--ghost"
              href={releasePage}
              data-download="linux-rpm"
            >
              Package
              <span class="button__note">.rpm</span>
            </a>
          </div>

          <p class="install-panel__note">
            <Icon name="check-circle" size={15} />
            The AppImage needs no installation. The .deb and .rpm packages add the app to your system.
          </p>

          <details class="install-details">
            <summary>Dependencies for the .deb and .rpm packages</summary>
            <p>WebKitGTK 4.1 and GTK 3, available in the usual repositories:</p>
            <code>sudo apt install libwebkit2gtk-4.1-0 libgtk-3-0 librsvg2-2</code>
            <code>sudo dnf install webkit2gtk4.1 gtk3 librsvg2</code>
          </details>
        </div>

        <ol class="install-steps">
          <li>
            <span class="install-steps__num number">01</span>
            <div>
              <strong>Download the AppImage</strong>
              <p>A single portable file, with no installation or extra dependencies.</p>
            </div>
          </li>
          <li>
            <span class="install-steps__num number">02</span>
            <div>
              <strong>Make it executable</strong>
              <p>Properties → Allow executing, or run <code>chmod +x</code> in the terminal.</p>
            </div>
          </li>
          <li>
            <span class="install-steps__num number">03</span>
            <div>
              <strong>Connect and pedal</strong>
              <p>Power on the trainer and find it in Devices. Your session is waiting.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>

    <div class="install__foot reveal">
      <span><Icon name="shield" size={16} /> No account or telemetry</span>
      <span><Icon name="github" size={16} /> Open source</span>
      <span><Icon name="check-circle" size={16} /> Free forever</span>
      <a class="text-link" href={releasePage} target="_blank" rel="noopener noreferrer">
        View all installers
        <Icon name="arrow-up-right" size={14} />
      </a>
    </div>
  </div>
</section>

<style>
  .install {
    overflow: hidden;
    background:
      radial-gradient(58% 48% at 50% 2%, rgba(242, 201, 76, 0.09), transparent 70%),
      linear-gradient(180deg, var(--surface-alt), #0d1319 30%, var(--bg));
    border-block: 1px solid var(--border-subtle);
  }

  .install__glow {
    position: absolute;
    top: -160px;
    left: 50%;
    width: min(80vw, 900px);
    height: 420px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(242, 201, 76, 0.12), transparent 66%);
    filter: blur(30px);
    pointer-events: none;
  }

  .install__head {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .install__head .eyebrow {
    justify-content: center;
  }

  .install__head h2 {
    margin-top: 16px;
    font-size: clamp(42px, 6vw, 72px);
  }

  .install__head .lede {
    margin: 22px auto 0;
  }

  .install__version {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-top: 24px;
    color: var(--text-muted);
    font-size: 13px;
  }

  .install__version-tag {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 2px 9px;
    border: 1px solid rgba(242, 201, 76, 0.3);
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .install__version-tag::before {
    content: 'v';
  }

  .install__version-sep {
    opacity: 0.4;
  }

  .install__version .text-link {
    font-size: 13px;
    text-decoration: none;
  }

  .install__tabs-wrap {
    display: flex;
    justify-content: center;
    margin-top: 42px;
  }

  .platform-tabs {
    display: inline-flex;
    gap: 4px;
    padding: 5px;
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    background: rgba(11, 16, 21, 0.6);
    backdrop-filter: blur(12px);
  }

  .platform-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 44px;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: var(--text-muted);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .platform-tab:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
  }

  .platform-tab[aria-selected='true'] {
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: 0 8px 24px -14px rgba(242, 201, 76, 0.9);
  }

  .install__shell {
    max-width: 1020px;
    margin: 26px auto 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 24px;
    background:
      linear-gradient(180deg, rgba(31, 42, 54, 0.42), rgba(15, 20, 25, 0.5)),
      var(--surface-alt);
    box-shadow: var(--shadow-deep);
  }

  .install-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  }

  .install-panel[hidden] {
    display: none;
  }

  .install-panel__main {
    padding: clamp(28px, 4vw, 46px);
    border-right: 1px solid var(--border-subtle);
  }

  .install-panel__kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .install-panel__main h3 {
    margin-top: 16px;
    max-width: 420px;
    font-size: clamp(28px, 3.2vw, 38px);
    letter-spacing: -0.03em;
  }

  .install-panel__main > p {
    max-width: 470px;
    margin-top: 14px;
    color: var(--text-secondary);
    font-size: 15.5px;
    line-height: 1.6;
  }

  .download-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .download-row .button {
    min-height: 50px;
    padding-inline: 20px;
    font-size: 15px;
  }

  .button__note {
    margin-left: 2px;
    opacity: 0.74;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .button--compact {
    padding-inline: 16px;
  }

  .download-row--linux {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .download-row--linux .button:first-child {
    grid-column: 1 / -1;
  }

  .install-panel__note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 20px !important;
    color: var(--text-muted) !important;
    font-size: 13px !important;
    line-height: 1.55 !important;
  }

  .install-panel__note svg {
    flex: none;
    margin-top: 2px;
    color: var(--ok);
  }

  .install-steps {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    padding: clamp(28px, 4vw, 42px);
    background: rgba(11, 16, 21, 0.28);
  }

  .install-steps li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .install-steps__num {
    flex: none;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .install-steps strong {
    display: block;
    font-size: 15px;
    font-weight: 600;
  }

  .install-steps p {
    margin-top: 4px;
    color: var(--text-muted);
    font-size: 13.5px;
    line-height: 1.55;
  }

  .install-steps code,
  .install-details code {
    padding: 1px 5px;
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text-secondary);
    font-size: 0.9em;
  }

  .install-details {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }

  .install-details summary {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .install-details summary::-webkit-details-marker {
    display: none;
  }

  .install-details summary::before {
    content: '+';
    display: inline-grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-secondary);
    font-size: 12px;
    line-height: 1;
  }

  .install-details[open] summary::before {
    content: '−';
  }

  .install-details p {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 12.5px;
    line-height: 1.55;
  }

  .install-details code {
    display: block;
    margin-top: 8px;
    padding: 8px 10px;
    overflow-x: auto;
    white-space: nowrap;
  }

  .install__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 28px;
    margin-top: 30px;
    color: var(--text-muted);
    font-size: 13px;
  }

  .install__foot > span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .install__foot svg {
    color: var(--accent);
    opacity: 0.8;
  }

  .install__foot .text-link {
    margin-left: 8px;
    font-size: 13px;
    text-decoration: none;
    color: var(--text);
  }

  @media (max-width: 840px) {
    .install-panel {
      grid-template-columns: 1fr;
    }

    .install-panel__main {
      border-right: 0;
      border-bottom: 1px solid var(--border-subtle);
    }

    .install-steps {
      gap: 18px;
    }
  }

  @media (max-width: 560px) {
    .platform-tabs {
      width: 100%;
    }

    .platform-tab {
      flex: 1;
      padding-inline: 10px;
      font-size: 14px;
    }

    .install__shell {
      border-radius: 18px;
    }

    .download-row {
      flex-direction: column;
    }

    .download-row .button {
      width: 100%;
    }

    .install__foot {
      gap: 8px 18px;
    }
  }
</style>
