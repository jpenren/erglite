---
import AppWindow from './AppWindow.astro';
import Icon from './Icon.astro';
import devices from '../assets/screens/05-devices.png';

const steps = [
  {
    number: '01',
    icon: 'bluetooth',
    title: 'Connect your trainer',
    text: 'Power on the trainer and find it in Devices. Bluetooth FTMS, with no cables or adapters.',
  },
  {
    number: '02',
    icon: 'route',
    title: 'Pick your workout',
    text: 'Open a session from the library, import a ZWO or draw your own route by gradient.',
  },
  {
    number: '03',
    icon: 'zap',
    title: 'Pedal',
    text: 'ErgLite controls resistance and records every watt. All you have to think about is cadence.',
  },
] as const;
---

<section class="section section--surface how" id="how-it-works">
  <div class="container">
    <div class="how__head reveal">
      <div>
        <span class="eyebrow">Up and running in 3 steps</span>
        <h2>From unboxing to your first interval.</h2>
      </div>
      <p class="lede">
        No endless setup. Install, connect and start pedalling: your first session can be rolling
        in under a minute.
      </p>
    </div>

    <div class="how__grid">
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="reveal" data-delay={index === 0 ? '0' : index === 1 ? '1' : '2'}>
              <span class="steps__number number">{step.number}</span>
              <div class="steps__body">
                <span class="steps__icon"><Icon name={step.icon} size={19} /></span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="how__visual reveal" data-delay="1">
        <div class="how__aura" aria-hidden="true"></div>
        <AppWindow
          src={devices}
          alt="ErgLite Devices screen with the trainer connected over Bluetooth, available sensors and their capabilities"
          title="Devices"
          tag="BLE"
          sizes="(max-width: 980px) 94vw, 590px"
        />

        <div class="how__badge" aria-hidden="true">
          <span class="status-dot"></span>
          <span>
            <strong>All set</strong>
            <small>Trainer + heart rate</small>
          </span>
        </div>
      </div>
    </div>

    <div class="how__cta reveal">
      <a class="text-link" href="#install">
        Install ErgLite
        <Icon name="arrow-right" size={16} />
      </a>
      <span class="muted">Free on Windows, macOS and Linux.</span>
    </div>
  </div>
</section>

<style>
  .how {
    overflow: hidden;
  }

  .how::before {
    content: '';
    position: absolute;
    top: 10%;
    right: -12%;
    width: 620px;
    height: 620px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(76, 154, 255, 0.06), transparent 68%);
    pointer-events: none;
  }

  .how__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
    margin-bottom: 54px;
  }

  .how__head h2 {
    margin-top: 16px;
    font-size: clamp(38px, 5vw, 60px);
  }

  .how__head .lede {
    max-width: 420px;
    padding-bottom: 6px;
  }

  .how__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    align-items: center;
    gap: clamp(44px, 6vw, 84px);
  }

  .steps {
    display: grid;
    gap: 0;
  }

  .steps li {
    position: relative;
    display: flex;
    gap: 20px;
    padding: 0 0 32px;
  }

  .steps li:last-child {
    padding-bottom: 0;
  }

  .steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 52px;
    left: 21px;
    bottom: 8px;
    width: 1px;
    background: linear-gradient(180deg, var(--border), var(--border-subtle));
  }

  .steps__number {
    flex: none;
    width: 43px;
    padding-top: 6px;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .steps__body {
    position: relative;
    flex: 1;
    padding: 4px 0 0;
  }

  .steps__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 13px;
    border: 1px solid var(--border-subtle);
    border-radius: 11px;
    background: var(--surface);
    color: var(--text-secondary);
  }

  .steps li:first-child .steps__icon {
    border-color: rgba(242, 201, 76, 0.25);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .steps h3 {
    font-size: 23px;
    letter-spacing: -0.025em;
  }

  .steps p {
    margin-top: 7px;
    max-width: 380px;
    color: var(--text-muted);
    font-size: 15.5px;
    line-height: 1.6;
  }

  .how__visual {
    position: relative;
  }

  .how__aura {
    position: absolute;
    inset: 6% -7% -8%;
    z-index: -1;
    background: radial-gradient(55% 55% at 50% 48%, rgba(76, 154, 255, 0.13), transparent 72%);
    filter: blur(50px);
  }

  .how__badge {
    position: absolute;
    left: -20px;
    bottom: 22px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px 12px 15px;
    border: 1px solid rgba(58, 70, 84, 0.85);
    border-radius: 13px;
    background: rgba(18, 25, 33, 0.9);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(16px);
  }

  .status-dot {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 5px rgba(61, 190, 122, 0.13);
  }

  .how__badge span:last-child {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .how__badge strong {
    font-size: 14px;
    font-weight: 600;
  }

  .how__badge small {
    color: var(--text-muted);
    font-size: 12px;
  }

  .how__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--border-subtle);
    font-size: 15px;
  }

  @media (max-width: 980px) {
    .how__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      margin-bottom: 42px;
    }

    .how__head .lede {
      max-width: 620px;
      padding-bottom: 0;
    }

    .how__grid {
      grid-template-columns: 1fr;
    }

    .how__visual {
      max-width: 720px;
    }

    .how__badge {
      left: 14px;
    }
  }

  @media (max-width: 560px) {
    .how__badge {
      display: none;
    }
  }
</style>
