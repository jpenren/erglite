---
import Icon from './Icon.astro';
import appIcon from '../assets/app-icon.png';

const base = import.meta.env.BASE_URL;
---

<header class="site-header" data-header>
  <div class="header-inner container">
    <a class="brand" href={base} aria-label="ErgLite, home">
      <img class="brand-mark" src={appIcon.src} alt="" width="34" height="34" />
      <span class="brand-name">Erg<span>Lite</span></span>
    </a>

    <div class="header-panel" id="site-nav">
      <nav class="site-nav" aria-label="Main navigation">
        <a href="#features">Features</a>
        <a href="#how-it-works">How it works</a>
        <a href="#install">Install</a>
        <a href="#faq">FAQ</a>
        <a
          class="site-nav__github"
          href="https://github.com/jpenren/erglite"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" size={18} />
          <span>GitHub</span>
        </a>
      </nav>
      <a class="button button--primary button--small header-cta" href="#install">
        <Icon name="download" size={17} />
        Download
      </a>
    </div>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
      data-nav-toggle
    >
      <span class="nav-toggle__icon" data-icon-open><Icon name="menu" size={22} /></span>
      <span class="nav-toggle__icon" data-icon-close><Icon name="close" size={22} /></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-height);
    border-bottom: 1px solid transparent;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      backdrop-filter 220ms ease;
  }

  .site-header[data-scrolled='true'] {
    background: rgba(15, 20, 25, 0.84);
    border-bottom-color: var(--border-subtle);
    backdrop-filter: blur(18px) saturate(1.3);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 30px;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    flex: none;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    box-shadow: 0 0 0 1px rgba(242, 201, 76, 0.22);
  }

  .brand-name span {
    color: var(--accent);
  }

  .header-panel {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 26px;
    flex: 1;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 8px;
    color: var(--text-secondary);
    font-size: 15px;
    font-weight: 500;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .site-nav a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
  }

  .site-nav__github {
    margin-left: 4px;
    border-left: 1px solid var(--border-subtle);
    border-radius: 0 8px 8px 0;
    padding-left: 16px !important;
  }

  .header-cta {
    flex: none;
  }

  .nav-toggle {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    padding: 0;
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    background: var(--surface-alt);
    cursor: pointer;
  }

  .nav-toggle__icon {
    display: grid;
    place-items: center;
  }

  .nav-toggle [data-icon-close] {
    display: none;
  }

  .site-header[data-open='true'] .nav-toggle [data-icon-open] {
    display: none;
  }

  .site-header[data-open='true'] .nav-toggle [data-icon-close] {
    display: grid;
  }

  @media (max-width: 980px) {
    .nav-toggle {
      display: grid;
    }

    .header-panel {
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
      padding: 18px var(--gutter) 26px;
      border-bottom: 1px solid var(--border-subtle);
      background: rgba(11, 16, 21, 0.97);
      backdrop-filter: blur(20px);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition:
        opacity 180ms ease,
        transform 180ms ease,
        visibility 180ms;
    }

    .site-header[data-open='true'] .header-panel {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .site-nav {
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
    }

    .site-nav a {
      min-height: 48px;
      padding-inline: 14px;
      font-size: 17px;
    }

    .site-nav__github {
      margin-top: 8px;
      margin-left: 0;
      border-left: 0;
      border-top: 1px solid var(--border-subtle);
      border-radius: 0 0 8px 8px;
      padding-top: 12px;
      padding-left: 14px !important;
    }

    .header-cta {
      min-height: 50px;
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .brand {
      font-size: 20px;
    }

    .brand-mark {
      width: 31px;
      height: 31px;
    }
  }
</style>
