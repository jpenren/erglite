---
const zones = [
  { id: 'Z1', name: 'Recovery', range: '< 55', color: 'var(--zone-1)' },
  { id: 'Z2', name: 'Endurance', range: '56–75', color: 'var(--zone-2)' },
  { id: 'Z3', name: 'Tempo', range: '76–90', color: 'var(--zone-3)' },
  { id: 'Z4', name: 'Threshold', range: '91–105', color: 'var(--zone-4)' },
  { id: 'Z5', name: 'VO₂max', range: '106–120', color: 'var(--zone-5)' },
  { id: 'Z6', name: 'Anaerobic', range: '121–150', color: 'var(--zone-6)' },
  { id: 'Z7', name: 'Sprint', range: '> 150', color: 'var(--zone-7)' },
] as const;
---

<section class="section section--tight zones" aria-labelledby="zones-title">
  <div class="container">
    <div class="zones__head">
      <div class="reveal">
        <span class="eyebrow">Power zones</span>
        <h2 id="zones-title">Seven zones. Zero guesswork.</h2>
      </div>
      <p class="zones__note reveal" data-delay="1">
        From easy spins to all-out sprints. The same colours throughout the app, always paired with
        a label: colour never stands alone.
      </p>
    </div>

    <ol class="zones__list reveal" data-delay="1">
      {
        zones.map((zone) => (
          <li style={`--zone-color:${zone.color}`}>
            <span class="zones__id number">{zone.id}</span>
            <strong>{zone.name}</strong>
            <span class="zones__range number">{zone.range}<small>% FTP</small></span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .zones {
    border-top: 1px solid var(--border-subtle);
  }

  .zones__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 42px;
  }

  .zones h2 {
    margin-top: 16px;
    font-size: clamp(34px, 4.4vw, 52px);
  }

  .zones__note {
    max-width: 390px;
    padding-bottom: 6px;
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .zones__list {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 10px;
  }

  .zones__list li {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 152px;
    padding: 18px 16px 16px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--zone-color);
    border-radius: 0 0 12px 12px;
    background: linear-gradient(180deg, rgba(31, 42, 54, 0.5), rgba(20, 27, 35, 0.74));
    transition:
      transform 200ms ease,
      border-color 200ms ease,
      background-color 200ms ease;
  }

  .zones__list li::after {
    content: '';
    position: absolute;
    top: -30px;
    right: -24px;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: var(--zone-color);
    opacity: 0.13;
    filter: blur(22px);
  }

  .zones__list li:hover {
    transform: translateY(-4px);
    border-color: var(--border);
  }

  .zones__id {
    color: var(--zone-color);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
  }

  .zones__list strong {
    margin-top: 9px;
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.15;
  }

  .zones__range {
    margin-top: auto;
    padding-top: 18px;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
  }

  .zones__range small {
    margin-left: 4px;
    color: var(--text-muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) {
    .zones__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      margin-bottom: 32px;
    }

    .zones__note {
      padding-bottom: 0;
    }

    .zones__list {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding-bottom: 12px;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
    }

    .zones__list li {
      flex: 0 0 154px;
      scroll-snap-align: start;
    }
  }
</style>
